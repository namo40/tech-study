---
import Header from '../components/Header.astro';
import { alternatePaths, defaultLocale, fontFamily, fontStylesheet, htmlLang, localePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { withBase } from '../utils/base';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Path below the locale segment, used for canonical and alternate URLs. */
  path?: string;
  /** Keeps the page out of search results and out of the alternate-URL set. */
  noindex?: boolean;
}

const { locale, title, description, path = '', noindex = false } = Astro.props;

const siteName = t(locale, 'site.name');
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const pageDescription = description ?? t(locale, 'site.description');
const alternates = alternatePaths(path);
const canonical = new URL(localePath(locale, path), Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[locale]} style={`--font-sans: ${fontFamily[locale]};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {
      /*
       * A page held back from search results drops the canonical and hreflang
       * links with it: the 404 stands in for every unknown address, so it has
       * no page of its own to name and no translations to point at.
       */
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <Fragment>
          <link rel="canonical" href={canonical} />
          {alternates.map(({ locale: other, path: href }) => (
            <link rel="alternate" hreflang={htmlLang[other]} href={new URL(href, Astro.site).href} />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localePath(defaultLocale, path), Astro.site).href}
          />
        </Fragment>
      )
    }

    <!--
      Only the face this locale needs is linked, and it is served from this
      site. The stylesheet is cut into one `@font-face` per unicode range, so
      the browser asks for the files the page's characters fall into and
      nothing else.
    -->
    <link rel="stylesheet" href={withBase(fontStylesheet[locale])} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={htmlLang[locale]} />

    <!-- Applies the stored theme and text size before the first paint. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (error) {
          theme = 'dark';
        }
        root.dataset.theme = theme;

        try {
          var sizes = ['large', 'larger', 'xlarge', 'largest'];
          var size = localStorage.getItem('text-size');
          if (sizes.indexOf(size) !== -1) {
            root.dataset.textSize = size;
          }
        } catch (error) {
          // Blocked storage: the normal size, which is the absence of the attribute.
        }
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <a class="skip-link" href="#main">{t(locale, 'nav.skipToContent')}</a>
      <Header locale={locale} path={path} />
      <main class="shell main" id="main">
        <slot />
      </main>
      <footer class="footer">
        <div class="shell footer__inner">
          <span>{t(locale, 'footer.aiNotice')}</span>
        </div>
      </footer>
    </div>

    <script>
      import { initThemeToggles } from '../scripts/theme';
      import { initTextSizeToggles } from '../scripts/text-size';

      initThemeToggles();
      initTextSizeToggles();
    </script>
  </body>
</html>
