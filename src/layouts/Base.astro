---
import Header from '../components/Header.astro';
import { alternatePaths, defaultLocale, fontFamily, fontStylesheet, htmlLang, localePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { withBase } from '../utils/base';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Path below the locale segment, used for canonical and alternate URLs. */
  path?: string;
}

const { locale, title, description, path = '' } = Astro.props;

const siteName = t(locale, 'site.name');
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const pageDescription = description ?? t(locale, 'site.description');
const alternates = alternatePaths(path);
const canonical = new URL(localePath(locale, path), Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[locale]} style={`--font-sans: ${fontFamily[locale]};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map(({ locale: other, path: href }) => (
        <link rel="alternate" hreflang={htmlLang[other]} href={new URL(href, Astro.site).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(defaultLocale, path), Astro.site).href}
    />

    <!-- Only the face this locale needs is requested. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontStylesheet[locale]} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang[locale]} />

    <!-- Applies the stored or preferred theme before the first paint. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (error) {
          theme = 'dark';
        }
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <a class="skip-link" href="#main">{t(locale, 'nav.skipToContent')}</a>
      <Header locale={locale} path={path} />
      <main class="shell main" id="main">
        <slot />
      </main>
      <footer class="footer">
        <div class="shell footer__inner">
          <span>{t(locale, 'footer.aiNotice')}</span>
        </div>
      </footer>
    </div>

    <script>
      import { initThemeToggles } from '../scripts/theme';

      initThemeToggles();
    </script>
  </body>
</html>
