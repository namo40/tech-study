---
import { getCollection, render } from 'astro:content';
import ScenePlayer from '../../components/ScenePlayer.astro';
import Base from '../../layouts/Base.astro';
import { localePath, t, toLocale, tSplit, type MessageKey } from '../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('concepts');

  return entries.map((entry) => {
    const [slug, lang] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const [slug, lang] = entry.id.split('/');
const locale = toLocale(lang);

const all = await getCollection('concepts');

// Related concepts only become links once the page for that slug exists.
const published = new Set(all.map((item) => item.id.split('/')[0]));

/*
 * A sub-keyword page names a scene but writes no steps of its own. It borrows
 * the step text of the page that owns the scene, in the same locale, so the
 * title card stays translated and there is only one place to edit it.
 */
const parentId = entry.data.scene ? `${entry.data.scene}/${lang}` : undefined;
const parent =
  parentId && parentId !== entry.id ? all.find((item) => item.id === parentId) : undefined;
const steps = entry.data.steps.length > 0 ? entry.data.steps : (parent?.data.steps ?? []);

// The "Part of" line is one message with a link in the middle, so the message
// is split around its placeholder instead of being assembled from fragments.
const [partOfBefore, partOfAfter] = tSplit(locale, 'concept.partOf', 'parent');
const showPartOf = Boolean(entry.data.sceneStep && parent);

/*
 * Tags live in the English file, so the localized page reads them from there
 * and every locale shows the same set. Each chip opens the index already
 * filtered on that tag.
 */
const englishEntry = all.find((item) => item.id === `${slug}/en`);
const tags = (englishEntry ?? entry).data.tags.map((tag) => ({
  label: t(locale, `tag.${tag}` as MessageKey),
  href: `${localePath(locale)}?tag=${tag}`,
}));

const { Content } = await render(entry);
---

<Base locale={locale} title={entry.data.title} description={entry.data.summary} path={slug}>
  <article>
    <header class="concept__header">
      <p class="concept__category">{entry.data.category}</p>
      <h1 class="concept__title">{entry.data.title}</h1>
      <p class="concept__summary">{entry.data.summary}</p>
      {tags.length > 0 && (
        <p class="concept__tags" role="group" aria-label={t(locale, 'home.tagLabel')}>
          {tags.map((tag) => (
            <a class="concept-tag" href={tag.href}>
              {tag.label}
            </a>
          ))}
        </p>
      )}
      {showPartOf && parent && (
        <p class="concept__parent">
          {partOfBefore}
          <a href={localePath(locale, entry.data.scene)}>{parent.data.title}</a>
          {partOfAfter}
        </p>
      )}
    </header>

    {entry.data.scene && (
      <ScenePlayer
        scene={entry.data.scene}
        locale={locale}
        steps={steps}
        startStep={entry.data.sceneStep}
      />
    )}

    <div class="prose">
      <Content />

      {
        entry.data.related.length > 0 && (
          <>
            <h2>{t(locale, 'section.related')}</h2>
            <ul class="link-list">
              {entry.data.related.map((item) => (
                <li>
                  {item.slug && published.has(item.slug) ? (
                    <a href={localePath(locale, item.slug)}>{item.label}</a>
                  ) : (
                    <>
                      {item.label}{' '}
                      <span class="link-list__note">({t(locale, 'related.noPage')})</span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        entry.data.references.length > 0 && (
          <>
            <h2>{t(locale, 'section.references')}</h2>
            <ul class="link-list">
              {entry.data.references.map((reference) => (
                <li>
                  <a href={reference.url} rel="noopener noreferrer">
                    {reference.title}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </article>
</Base>
