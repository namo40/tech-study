---
import { getCollection, render } from 'astro:content';
import ScenePlayer from '../../components/ScenePlayer.astro';
import Base from '../../layouts/Base.astro';
import { localePath, t, toLocale, tSplit, type MessageKey } from '../../i18n';
import { bandRange, levelBand } from '../../utils/level';
import { pageRevision } from '../../utils/revision';

export async function getStaticPaths() {
  const entries = await getCollection('concepts');

  return entries.map((entry) => {
    const [slug, lang] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const [slug, lang] = entry.id.split('/');
const locale = toLocale(lang);

const all = await getCollection('concepts');

// Related concepts only become links once the page for that slug exists.
const published = new Set(all.map((item) => item.id.split('/')[0]));

/*
 * A page can name a scene that another page owns: a sub-keyword page opens on
 * one of its steps, and an alias page borrows the whole scene. Neither writes
 * steps of its own, so both take the owning page's step text in the same
 * locale, which keeps the title card translated and leaves one place to edit
 * it.
 */
const parentId = entry.data.scene ? `${entry.data.scene}/${lang}` : undefined;
const parent =
  parentId && parentId !== entry.id ? all.find((item) => item.id === parentId) : undefined;
const steps = entry.data.steps.length > 0 ? entry.data.steps : (parent?.data.steps ?? []);

// The "Part of" line is one message with a link in the middle, so the message
// is split around its placeholder instead of being assembled from fragments.
const [partOfBefore, partOfAfter] = tSplit(locale, 'concept.partOf', 'parent');
const showPartOf = Boolean(parent);

/*
 * Tags live in the English file, so the localized page reads them from there
 * and every locale shows the same set. Each chip opens the index already
 * filtered on that tag.
 */
const englishEntry = all.find((item) => item.id === `${slug}/en`);
const tags = (englishEntry ?? entry).data.tags.map((tag) => ({
  label: t(locale, `tag.${tag}` as MessageKey),
  href: `${localePath(locale)}?tag=${tag}`,
}));

/*
 * Difficulty is read from the English file for the same reason, and a page
 * that borrows a parent's scene still carries its own number rather than
 * inheriting one. The chip opens the index on the band the level falls in, so
 * it is the same kind of way in as a tag chip. Every page has a level, and the
 * value is still read as optional only because the schema has to let a Korean
 * or Japanese file through without one.
 */
const level = (englishEntry ?? entry).data.level;
const levelLabel = level === undefined ? '' : t(locale, 'level.of', { level });

/*
 * The revision travels with the page so the browser can tell a reader who
 * marked it as read that it has been rewritten since. It is per locale file,
 * which is why it is taken from this entry rather than from the English one.
 */
const revision = pageRevision(entry);

const { Content } = await render(entry);
---

<Base locale={locale} title={entry.data.title} description={entry.data.summary} path={slug}>
  <article>
    <header class="concept__header">
      <p class="concept__meta">
        <span class="concept__category">{entry.data.category}</span>
        {level !== undefined && (
          <a
            class="concept-level"
            href={`${localePath(locale)}?level=${bandRange(levelBand(level))}`}
            title={levelLabel}
            aria-label={levelLabel}
          >
            {t(locale, 'level.short', { level })}
          </a>
        )}
        <span class="concept__actions" data-reading data-slug={slug} data-lang={locale} data-rev={revision}>
          <button
            type="button"
            class="concept-action"
            data-read-toggle
            aria-pressed="false"
            data-label-unread={t(locale, 'reading.markRead')}
            data-label-read={t(locale, 'reading.state.read')}
            data-label-updated={t(locale, 'reading.markReadAgain')}
            data-title-read={t(locale, 'reading.markUnread')}
          >
            <span class="concept-action__symbol" data-read-symbol aria-hidden="true"></span>
            <span data-read-label>{t(locale, 'reading.markRead')}</span>
          </button>
          <span class="concept-action__note" data-updated-note hidden>{t(locale, 'reading.updatedNote')}</span>
          <button
            type="button"
            class="concept-action"
            data-bookmark-toggle
            aria-pressed="false"
            data-label-off={t(locale, 'reading.bookmark')}
            data-label-on={t(locale, 'reading.bookmarked')}
            data-title-on={t(locale, 'reading.removeBookmark')}
          >
            <span class="concept-action__symbol" data-bookmark-symbol aria-hidden="true">☆</span>
            <span data-bookmark-label>{t(locale, 'reading.bookmark')}</span>
          </button>
        </span>
      </p>
      <h1 class="concept__title">{entry.data.title}</h1>
      <p class="concept__summary">{entry.data.summary}</p>
      {tags.length > 0 && (
        <p class="concept__tags" role="group" aria-label={t(locale, 'home.tagLabel')}>
          {tags.map((tag) => (
            <a class="concept-tag" href={tag.href}>
              {tag.label}
            </a>
          ))}
        </p>
      )}
      {showPartOf && parent && (
        <p class="concept__parent">
          {partOfBefore}
          <a href={localePath(locale, entry.data.scene)}>{parent.data.title}</a>
          {partOfAfter}
        </p>
      )}
    </header>

    {entry.data.scene && (
      <ScenePlayer
        scene={entry.data.scene}
        locale={locale}
        steps={steps}
        startStep={entry.data.sceneStep}
      />
    )}

    <div class="prose">
      <Content />

      {
        entry.data.related.length > 0 && (
          <>
            <h2>{t(locale, 'section.related')}</h2>
            <ul class="link-list">
              {entry.data.related.map((item) => (
                <li>
                  {item.slug && published.has(item.slug) ? (
                    <a href={localePath(locale, item.slug)}>{item.label}</a>
                  ) : (
                    <>
                      {item.label}{' '}
                      <span class="link-list__note">({t(locale, 'related.noPage')})</span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        entry.data.references.length > 0 && (
          <>
            <h2>{t(locale, 'section.references')}</h2>
            <ul class="link-list">
              {entry.data.references.map((reference) => (
                <li>
                  <a href={reference.url} rel="noopener noreferrer">
                    {reference.title}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </article>
</Base>

<script>
  import { initReadingControls } from '../../scripts/reading';

  initReadingControls();
</script>
