---
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!--
  The icon shows the theme that is currently active, so the sun belongs to the
  dark theme: pressing it moves to the light theme. The server renders the dark
  variant because that is the default; `theme.ts` corrects it on load.
-->
<button
  type="button"
  class="btn"
  data-theme-toggle
  aria-pressed="true"
  aria-label={t(locale, 'theme.toLight')}
  data-label-to-light={t(locale, 'theme.toLight')}
  data-label-to-dark={t(locale, 'theme.toDark')}
>
  <svg class="btn__icon" data-theme-icon="dark" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg class="btn__icon is-hidden" data-theme-icon="light" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
  </svg>
</button>
